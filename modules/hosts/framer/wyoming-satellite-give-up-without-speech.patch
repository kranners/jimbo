+    def _cancel_speech_timeout(self) -> None:
+        if self._speech_timeout is not None:
+            self._speech_timeout.cancel()
+            self._speech_timeout = None
+
+    def _expect_speech_within(self, seconds: float) -> None:
+        self._cancel_speech_timeout()
+        self._speech_timeout = asyncio.create_task(self._give_up_without_speech(seconds))
+
+    async def _give_up_without_speech(self, seconds: float) -> None:
+        await asyncio.sleep(seconds)
+        self._speech_timeout = None
+        if not self.is_streaming:
+            return
+
+        _LOGGER.info("No speech %s second(s) after streaming started, giving up", seconds)
+        self.is_streaming = False
+        await self.event_to_server(AudioStop().event())
