;; Library

(defwidget icon_button [onclick icon icon-size]
  (button
    :onclick onclick
    :halign "center"
    :valign "center"
    :class "icon_button"
    (image
      :icon icon
      :icon-size icon-size
    )
  )
)

;; Date & time

(defwidget datetime []
  (box
    :orientation "vertical"
    :space-evenly false
    :valign "center"
    (label
      :class "xl"
      :halign "center"
      :text {formattime(EWW_TIME, "%I:%M%P")}
    )
    (label
      :class "lg"
      :halign "center"
      :text {formattime(EWW_TIME, "%A, %m %B %Y")}
    )
  )
)

;; Weather

(defpoll weather_icon
  :interval "15m"
  `scripts/weather.py --select icon`
)

(defpoll weather_description
  :interval "15m"
  `scripts/weather.py --select description`
)

(defpoll weather_temperature
  :interval "15m"
  `scripts/weather.py --select temperature`
)

(defwidget current_weather []
  (box
    :orientation "horizontal"
    :space-evenly false
    :halign "center"
    :spacing 12
    (image
      :icon weather_icon
      :icon-size "dialog"
    )
    (box
      :orientation "vertical"
      :space-evenly false
      :valign "center"
      :halign "center"
      (label
        :class "lg"
        :halign "start"
        :text weather_temperature
      )
      (label
        :class "sm"
        :halign "start"
        :text weather_description
      )
    )
  )
)

;; Audio output controls

(defpoll volume
  :interval "1s"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)}'`
)

(defpoll is_muted
  :interval "0.5s"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo 1 || echo 0`
)

(defwidget volume_slider []
  (scale
    :hexpand true
    :min 0
    :max 100
    :value volume
    :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ $(awk 'BEGIN {print {}/100}') ; eww update volume={}"
  )
)

(defwidget mute_toggle_button []
  (icon_button
    :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    :icon-size "large-toolbar"
    :icon {
      is_muted == 1 ? "audio-volume-muted"
      : volume > 60 ? "audio-volume-high" 
      : volume > 30 ? "audio-volume-medium"
      : volume > 0 ? "audio-volume-low"
      : "audio-volume-muted"
    }
  )
)

(defwidget audio_output_selector []
  (box
    :orientation "horizontal"
    :space-evenly false
    :halign "center"
    :valign "center"
    :spacing 12
    (icon_button
      :onclick "scripts/set_output_device.py 'iFi USB Audio SE Analog Stereo'"
      :class "icon_button"
      :icon "audio-headphones"
      :icon-size "large-toolbar"
    )
    (icon_button
      :onclick "scripts/set_output_device.py 'USB SPDIF Adapter Analog Stereo'"
      :class "icon_button"
      :icon "audio-speakers"
      :icon-size "large-toolbar"
    )
  )
)

(defwidget audio_controls []
  (box
    :halign "fill"
    :space-evenly false
    (mute_toggle_button)
    (volume_slider)
    (audio_output_selector)
  )
)

;; Brightness controls

(defpoll brightness
  :interval "5s"
  :initial 50
  `brightness get`
)

(defwidget brightness_slider []
  (scale
    :hexpand true
    :min 0
    :max 100
    :value brightness
    :onchange "brightness set {} ; eww update brightness={}"
  )
)

(defwidget brightness_controls []
  (box
    :halign "fill"
    :space-evenly false
    (icon_button
      :onclick "brightness down ; eww update brightness=$(brightness get)"
      :icon-size "large-toolbar"
      :icon "display-brightness-low-symbolic"
    )
    (brightness_slider)
    (icon_button
      :onclick "brightness up ; eww update brightness=$(brightness get)"
      :icon-size "large-toolbar"
      :icon "display-brightness-high-symbolic"
    )
  )
)

;; Wallpaper controls

(defpoll wallpaper_monitors
  :interval "30s"
  :initial ""
  `wpaperctl status --json | jq --raw-output '.[].display' | paste --serial --delimiters ' '`
)

(defpoll wallpaper_paused
  :interval "5s"
  :initial 0
  `wpaperctl status --json | grep -q '"paused"' && echo 1 || echo 0`
)

(defpoll wallpaper_image
  :interval "2s"
  :initial ""
  `wpaperctl get "$(wpaperctl status --json | jq --raw-output '.[0].display')"`
)

(defwidget wallpaper_controls []
  (box
    :space-evenly false
    :halign "center"
    :spacing 12
    (image
      :class "wallpaper_preview"
      :path wallpaper_image
      :image-width 96
    )
    (box
      :space-evenly false
      :valign "center"
      :spacing 12
      (icon_button
        :icon "go-previous-symbolic"
        :icon-size "large-toolbar"
        :onclick "wpaperctl previous ${wallpaper_monitors}"
      )
      (icon_button
        :icon {
          wallpaper_paused == 1
          ? "media-playback-start"
          : "media-playback-pause"
        }
        :icon-size "large-toolbar"
        :onclick "wpaperctl toggle-pause ; eww update wallpaper_paused=$(wpaperctl status --json | grep -q '\"paused\"' && echo 1 || echo 0)"
      )
      (icon_button
        :icon "go-next-symbolic"
        :icon-size "large-toolbar"
        :onclick "wpaperctl next ${wallpaper_monitors}"
      )
    )
  )
)

;; Power controls

(defwidget power_controls []
  (box
    :space-evenly false
    :halign "center"
    :spacing 24
    (icon_button
      :icon "system-shutdown"
      :icon-size "large-toolbar"
      :onclick "systemctl poweroff"
    )
    (icon_button
      :icon "system-reboot"
      :icon-size "large-toolbar"
      :onclick "systemctl reboot"
    )
    (icon_button
      :icon "system-lock-screen"
      :icon-size "large-toolbar"
      :onclick "uwsm stop"
    )
    (icon_button
      :icon "computer"
      :icon-size "large-toolbar"
      :onclick "systemctl reboot --firmware-setup"
    )
  )
)

;; Hardware and network info

(defvar bytes_per_gibibyte 1073741824)

(defvar bytes_per_megabit 125000)

(defpoll connected_device
  :interval "2s"
  `nmcli --get-values device,state device | grep ':connected$' | grep -v '^lo:' | cut -d: -f1`
)

(defpoll download_speed
  :interval "2s"
  :initial 0
  `scripts/network_speed.py download`
)

(defpoll upload_speed
  :interval "2s"
  :initial 0
  `scripts/network_speed.py upload`
)

(defwidget hardware_label [icon text subtitle]
  (box
    :space-evenly false
    :spacing 8
    (image
      :class "hardware_label_icon"
      :icon icon
      :icon-size "large-toolbar"
      :width 48
      :height 48
    )
    (box
      :orientation "vertical"
      :space-evenly "false"
      :valign "center"
      (label
        :class "md"
        :text text
        :halign "start"
      )
      (label
        :class "xs"
        :text subtitle
        :halign "start"
      )
    )
  )
)

(defwidget network_info []
  (box
    :orientation "vertical"
    :spacing 12
    (hardware_label
      :icon { 
        matches(connected_device, "enp.*")
        ? "network-wired-symbolic"
        : "network-wireless-symbolic"
      }
      :text connected_device
      :subtitle "Connected device"
    )
    (hardware_label
      :icon "go-down"
      :text { round(download_speed / bytes_per_megabit, 1) + "Mbps" }
      :subtitle "Download speed"
    )
    (hardware_label
      :icon "go-up"
      :text { round(upload_speed / bytes_per_megabit, 1) + "Mbps" }
      :subtitle "Upload speed"
    )
  )
)

(defpoll gpu_temperature
  :interval "2s"
  `sensors -j amdgpu-pci-2d00 | jq '.["amdgpu-pci-2d00"].junction.temp2_input'`
)

(defpoll cpu_temperature
  :interval "2s"
  `sensors -j k10temp-pci-00c3 | jq '.["k10temp-pci-00c3"].Tctl.temp1_input'`
)

(defpoll gpu_utilization
  :interval "2s"
  `cat /sys/class/drm/card1/device/gpu_busy_percent`
)

(defwidget hardware_info []
  (box
    :orientation "horizontal"
    :spacing 12
    :halign "center"
    (box
      :orientation "vertical"
      :spacing 12
      (hardware_label
        :icon "power-profile-performance"
        :text {round(EWW_CPU["avg"], 1) + "%"}
        :subtitle "CPU utilization"
      )
      (hardware_label
        :icon "drive-harddisk-solidstate"
        :text {
          round(
          EWW_RAM["used_mem"] / EWW_RAM["total_mem"] * 100,
          1
        ) + "%"
        }
        :subtitle "Used memory"
      )
      (hardware_label
        :icon "drive-harddisk-symbolic"
        :text {
          round(
          EWW_DISK["/"]["used"] / EWW_DISK["/"]["total"] * 100,
          1
        ) + "%"
        }
        :subtitle "Used disk"
      )
    )
    (box
      :orientation "vertical"
      :spacing 12
      (hardware_label
        :icon "applications-games-symbolic"
        :text { round(gpu_utilization, 1) + "%" }
        :subtitle "GPU utilization"
      )
      (hardware_label
        :icon "uninterruptible-power-supply-symbolic"
        :text { round(cpu_temperature, 1) + "°C" }
        :subtitle "CPU temp"
      )
      (hardware_label
        :icon "video-display-symbolic"
        :text { round(gpu_temperature, 1) + "°C" }
        :subtitle "GPU temp"
      )
    )
    (network_info)
  )
)

;; Local LLM diagnostics

(defpoll llm
  :interval "2s"
  :initial `{"online":false,"model":"","slots_total":0,"requests_processing":0,"requests_deferred":0,"prompt_tokens_per_second":0,"generated_tokens_per_second":0,"gateway_state":"unknown","server_state":"unknown"}`
  `llm-status`
)

(defwidget llm_info []
  (box
    :orientation "horizontal"
    :spacing 12
    :halign "center"
    (box
      :orientation "vertical"
      :spacing 12
      (hardware_label
        :icon {
          llm.online
          ? "emblem-ok-symbolic"
          : "dialog-warning-symbolic"
        }
        :text { llm.online ? llm.model : "offline" }
        :subtitle "Local model"
      )
      (hardware_label
        :icon "network-server-symbolic"
        :text { llm.server_state + " / " + llm.gateway_state }
        :subtitle "llama.cpp / OpenClaw"
      )
      (hardware_label
        :icon "system-run-symbolic"
        :text {
          llm.requests_processing + " / " + llm.slots_total
          + (llm.requests_deferred > 0
             ? " (+" + llm.requests_deferred + " queued)"
             : "")
        }
        :subtitle "Busy slots"
      )
    )
    (box
      :orientation "vertical"
      :spacing 12
      (hardware_label
        :icon "document-edit-symbolic"
        :text { round(llm.prompt_tokens_per_second, 0) + " tok/s" }
        :subtitle "Prompt throughput"
      )
      (hardware_label
        :icon "media-playback-start-symbolic"
        :text { round(llm.generated_tokens_per_second, 1) + " tok/s" }
        :subtitle "Generation throughput"
      )
    )
  )
)

;; Notifications

(defpoll total_notifications
  :interval "2s"
  `swaync-client --count`
)

(defwidget icon_label_button [icon text onclick]
  (button
    :valign "center"
    :class "notification_button"
    :onclick onclick
    (box
      :space-evenly false
      :spacing 8
      :valign "center"
      (image
        :icon icon
        :icon-size "small-toolbar"
      )
      (label
        :class "notification_button_label"
        :text text
      )
    )
  )
)

(defwidget notifications []
  (box
    :space-evenly false
    :halign "center"
    :spacing 24
    (label
      :class "md"
      :text {
        total_notifications > 0
        ? total_notifications + " notifications"
        : "No notifications"
      }
    )
    (icon_label_button
      :icon "user-trash-symbolic"
      :text "Clear"
      :onclick "swaync-client --close-all ; eww update total_notifications=$(swaync-client --count)"
    )
    (icon_label_button
      :icon "view-fullscreen-symbolic"
      :text "Toggle panel"
      :onclick "swaync-client --toggle-panel"
    )
  )
)

;; Night shift

(defpoll night_shift
  :interval "2s"
  :initial `{"active":false,"temperature":6000,"setpoint":4000,"minimum":2000,"maximum":6000,"text":"","class":"inactive","label":"Night shift off","tooltip":"Night shift off"}`
  `night-shift status`
)

(defwidget night_shift_toggle []
  (icon_label_button
    :icon {
      night_shift.active
      ? "weather-clear-night-symbolic"
      : "weather-clear-symbolic"
    }
    :text { night_shift.label }
    :onclick "night-shift toggle ; eww update night_shift=\"$(night-shift status)\""
  )
)

(defwidget night_shift_slider []
  (scale
    :hexpand true
    :min { night_shift.minimum }
    :max { night_shift.maximum }
    :value { night_shift.setpoint }
    :onchange "night-shift set {} ; eww update night_shift=\"$(night-shift status)\""
  )
)

(defwidget night_shift_controls []
  (box
    :class "night_shift_controls"
    :space-evenly false
    :spacing 12
    :halign "center"
    :width 320
    (night_shift_toggle)
    (night_shift_slider)
  )
)

;; App launchers

(defwidget launcher [onclick icon title hotkey]
  (button
    :onclick onclick
    :timeout 10000
    :class "launcher"
    :width 128
    (box
      :orientation "horizontal"
      :space-evenly false
      :spacing 12
      (image
        :icon icon
        :icon-size "large-toolbar"
      )
      (box
        :orientation "vertical"
        (label
          :class "sm"
          :text title
          :justify "left"
          :halign "start"
        )
        (label
          :class "xs"
          :text hotkey
          :justify "left"
          :halign "start"
        )
      )
    )
  )
)

(defwidget launcher_panel []
  (box
    :halign "center"
    :valign "center"
    :orientation "horizontal"
    :class "launcher_panel"
    :spacing 8
    (box
      :spacing 8
      :halign "start"
      :orientation "vertical"
      (launcher
        :onclick "uwsm app -- obsidian &"
        :icon "obsidian"
        :title "Obsidian"
        :hotkey "Mod+O"
      )
      (launcher
        :onclick "uwsm app -- steam &"
        :icon "steam"
        :title "Steam"
        :hotkey "Mod+S"
      )
      (launcher
        :onclick "uwsm app -- vesktop &"
        :icon "discord"
        :title "Vesktop"
        :hotkey "Mod+V"
      )
    )
    (box
      :spacing 8
      :orientation "vertical"
      :halign "start"
      (launcher
        :onclick "uwsm app -- ghostty &"
        :icon "utilities-terminal"
        :title "Ghostty"
        :hotkey "Mod+Enter"
      )
      (launcher
        :onclick "uwsm app -- chromium &"
        :icon "chromium"
        :title "Chromium"
        :hotkey "Mod+B"
      )
      (launcher
        :onclick "uwsm app -- plexamp &"
        :icon "plexamp"
        :title "Plexamp"
        :hotkey "Mod+P"
      )
    )
    (box
      :spacing 8
      :orientation "vertical"
      :halign "start"
      (launcher
        :onclick "uwsm app -- spotify &"
        :icon "spotify"
        :title "Spotify"
        :hotkey "Mod+Y"
      )
      (launcher
        :onclick "uwsm app -- nautilus &"
        :icon "system-file-manager"
        :title "Nautilus"
        :hotkey "Mod+E"
      )
    )
  )
)

;; Media controls

(defpoll media_art_url
  :interval "2s"
  `playerctl metadata --format "{{mpris:artUrl}}" | sed 's|^file://||'`
)

(defpoll media_song_title
  :interval "2s"
  `playerctl metadata --format "{{xesam:title}}"`
)

(defpoll media_album
  :interval "2s"
  `playerctl metadata --format "{{xesam:album}}"`
)

(defpoll media_artist
  :interval "2s"
  `playerctl metadata --format "{{xesam:artist}}"`
)

(defpoll is_playing
  :interval "2s"
  `playerctl status`
)

(defwidget media_info []
  (box
    :space-evenly false
    :spacing 8
    :halign "center"
    :valign "center"
    :orientation "vertical"
    (label
      :halign "start"
      :class "lg"
      :truncate true
      :text media_song_title
    )
    (label
      :halign "start"
      :class "md"
      :truncate true
      :text media_artist
    )
    (label
      :halign "start"
      :class "sm"
      :truncate true
      :text media_album
    )
  )
)

(defwidget playback_controls []
  (box
    :space-evenly false
    :halign "center"
    :spacing 12
    (icon_button
      :icon "go-previous-symbolic"
      :icon-size "large-toolbar"
      :onclick "playerctl previous"
    )
    (icon_button
      :icon {
        is_playing == "Playing"
        ? "media-playback-pause"
        : "media-playback-start"
      }
      :icon-size "large-toolbar"
      :onclick "playerctl play-pause ; eww update is_playing=$(playerctl status)"
    )
    (icon_button
      :icon "go-next-symbolic"
      :icon-size "large-toolbar"
      :onclick "playerctl next"
    )
  )
)

(defwidget media_controls []
  (box
    :space-evenly false
    :spacing 12
    :halign "center"
    (image
      :path media_art_url
      :image-width 256
    )
    (box
      :orientation "vertical"
      :valign "center"
      :spacing 24
      (media_info)
      (playback_controls)
    )
  )
)

;; Quick settings tabs

(defvar quick_tab "system")

(defwidget tab_button [tab icon text]
  (button
    :class {quick_tab == tab ? "tab_button active" : "tab_button"}
    :hexpand true
    :onclick "eww update quick_tab=${tab}"
    (box
      :space-evenly false
      :spacing 8
      :halign "center"
      (image
        :icon icon
        :icon-size "small-toolbar"
      )
      (label
        :class "sm"
        :text text
      )
    )
  )
)

(defwidget tab_bar []
  (box
    :class "tab_bar"
    :spacing 8
    (tab_button
      :tab "system"
      :icon "computer-symbolic"
      :text "System"
    )
    (tab_button
      :tab "network"
      :icon "network-wireless-symbolic"
      :text "Network"
    )
    (tab_button
      :tab "processes"
      :icon "utilities-system-monitor-symbolic"
      :text "Processes"
    )
  )
)

;; Wi-Fi

(defpoll wifi_status
  :interval "5s"
  :run-while {quick_tab == "network"}
  :initial `{"enabled":false,"connected":false,"ssid":"","signal":0,"label":"Not connected"}`
  `quick-wifi status`
)

(defpoll wifi_list
  :interval "10s"
  :run-while {quick_tab == "network"}
  :initial "[]"
  `quick-wifi list`
)

(defwidget wifi_row [network]
  (button
    :class "list_row"
    :onclick {"quick-wifi connect '" + network.ssid + "' ; eww poll wifi_status wifi_list"}
    (box
      :space-evenly false
      :spacing 8
      (image
        :icon {network.signal >= 75 ? "network-wireless-signal-excellent-symbolic"
             : network.signal >= 50 ? "network-wireless-signal-good-symbolic"
             : network.signal >= 25 ? "network-wireless-signal-ok-symbolic"
             : "network-wireless-signal-weak-symbolic"}
        :icon-size "small-toolbar"
      )
      (label
        :class {network.active ? "sm" : "xs"}
        :halign "start"
        :hexpand true
        :limit-width 30
        :text {network.ssid}
      )
      (image
        :visible {network.secure}
        :icon "channel-secure-symbolic"
        :icon-size "small-toolbar"
      )
      (image
        :visible {network.active}
        :icon "object-select-symbolic"
        :icon-size "small-toolbar"
      )
    )
  )
)

(defwidget wifi_controls []
  (box
    :orientation "vertical"
    :space-evenly false
    :spacing 8
    (box
      :space-evenly false
      :spacing 8
      (label
        :class "md"
        :halign "start"
        :hexpand true
        :text {wifi_status.enabled ? wifi_status.label : "Wi-Fi off"}
      )
      (icon_button
        :icon "view-refresh-symbolic"
        :icon-size "small-toolbar"
        :onclick "quick-wifi rescan ; eww poll wifi_status wifi_list"
      )
      (icon_button
        :icon {wifi_status.enabled ? "network-wireless-symbolic" : "network-wireless-offline-symbolic"}
        :icon-size "small-toolbar"
        :onclick "quick-wifi toggle ; eww poll wifi_status wifi_list"
      )
    )
    (scroll
      :vscroll true
      :height 170
      (box
        :orientation "vertical"
        :space-evenly false
        (for network in wifi_list
          (wifi_row :network network)
        )
      )
    )
  )
)

;; Bluetooth

(defpoll bluetooth_status
  :interval "5s"
  :run-while {quick_tab == "network"}
  :initial `{"powered":false,"label":"Bluetooth off"}`
  `quick-bluetooth status`
)

(defpoll bluetooth_list
  :interval "5s"
  :run-while {quick_tab == "network"}
  :initial "[]"
  `quick-bluetooth list`
)

(defwidget bluetooth_row [device]
  (button
    :class "list_row"
    :onclick {(device.connected ? "quick-bluetooth disconnect " : "quick-bluetooth connect ")
              + device.mac
              + " ; eww poll bluetooth_status bluetooth_list"}
    (box
      :space-evenly false
      :spacing 8
      (image
        :icon {device.connected ? "bluetooth-active-symbolic" : "bluetooth-disabled-symbolic"}
        :icon-size "small-toolbar"
      )
      (label
        :class {device.connected ? "sm" : "xs"}
        :halign "start"
        :hexpand true
        :limit-width 30
        :text {device.name}
      )
      (image
        :visible {device.connected}
        :icon "object-select-symbolic"
        :icon-size "small-toolbar"
      )
    )
  )
)

(defwidget bluetooth_controls []
  (box
    :orientation "vertical"
    :space-evenly false
    :spacing 8
    (box
      :space-evenly false
      :spacing 8
      (label
        :class "md"
        :halign "start"
        :hexpand true
        :text {bluetooth_status.label}
      )
      (icon_button
        :icon "list-add-symbolic"
        :icon-size "small-toolbar"
        :onclick "quick-bluetooth pair"
      )
      (icon_button
        :icon {bluetooth_status.powered ? "bluetooth-active-symbolic" : "bluetooth-disabled-symbolic"}
        :icon-size "small-toolbar"
        :onclick "quick-bluetooth toggle ; eww poll bluetooth_status bluetooth_list"
      )
    )
    (scroll
      :vscroll true
      :height 130
      (box
        :orientation "vertical"
        :space-evenly false
        (for device in bluetooth_list
          (bluetooth_row :device device)
        )
      )
    )
  )
)

(defwidget network_panel []
  (box
    :orientation "vertical"
    :space-evenly false
    :valign "center"
    :spacing 24
    (wifi_controls)
    (bluetooth_controls)
  )
)

;; Processes

(defvar process_sort "cpu")

;; defpoll scripts are static, so the script returns both orderings at once and
;; the sort toggle just picks one.
(defpoll processes
  :interval "2s"
  :run-while {quick_tab == "processes"}
  :initial `{"cpu":[],"mem":[]}`
  `quick-processes list`
)

(defwidget process_row [process]
  (box
    :class "list_row"
    :space-evenly false
    :spacing 8
    (label
      :class "sm"
      :halign "start"
      :hexpand true
      :limit-width 28
      :text {process.name}
    )
    (label
      :class {process_sort == "cpu" ? "sm" : "xs"}
      :width 80
      :text "${round(process.cpu, 1)}%"
    )
    (label
      :class {process_sort == "mem" ? "sm" : "xs"}
      :width 80
      :text "${round(process.mem, 1)}%"
    )
    (icon_button
      :icon "window-close-symbolic"
      :icon-size "small-toolbar"
      :onclick {"quick-processes kill " + process.pid + " ; eww poll processes"}
    )
  )
)

(defwidget process_panel []
  (box
    :orientation "vertical"
    :space-evenly false
    :valign "center"
    :spacing 8
    (box
      :space-evenly false
      :spacing 8
      (label
        :class "md"
        :halign "start"
        :hexpand true
        :text "Top processes"
      )
      (icon_label_button
        :icon "utilities-system-monitor-symbolic"
        :text {process_sort == "cpu" ? "By CPU" : "By memory"}
        :onclick {"eww update process_sort=" + (process_sort == "cpu" ? "mem" : "cpu")}
      )
    )
    (box
      :orientation "vertical"
      :space-evenly false
      (for process in {process_sort == "cpu" ? processes.cpu : processes.mem}
        (process_row :process process)
      )
    )
  )
)

(defwidget system_panel []
  (box
    :orientation "vertical"
    :space-evenly false
    :valign "center"
    :spacing 24
    (hardware_info)
    (llm_info)
    (media_controls)
    (audio_controls)
    (brightness_controls)
    (wallpaper_controls)
  )
)

;; Layout and window

(defwidget layout []
  (box
    :orientation "horizontal"
    (box
      :class "column"
      :orientation "vertical"
      :halign "fill"
      :valign "fill"
      (box
        :orientation "vertical"
        :space-evenly false
        :halign "center"
        :valign "center"
        :spacing 24
        (datetime)
        (current_weather)
        (notifications)
        (night_shift_controls)
        (launcher_panel)
        (power_controls)
      )
    )
    (box
      :class "column"
      :orientation "vertical"
      :space-evenly false
      :valign "fill"
      :spacing 12
      (tab_bar)
      (stack
        :selected {quick_tab == "system" ? 0 : quick_tab == "network" ? 1 : 2}
        :transition "none"
        :vexpand true
        (system_panel)
        (network_panel)
        (process_panel)
      )
    )
  )
)

(defwindow dashboard
  :monitor 0
  :stacking "fg"
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "1250"
    :height "700"
    :anchor "center"
  )
  :class "container"
  (layout)
)


(defwindow night_shift
  :monitor 0
  :stacking "overlay"
  :geometry (geometry
    :y "12px"
    :width "360"
    :anchor "top right"
  )
  :class "night_shift_popup"
  (night_shift_controls)
)
